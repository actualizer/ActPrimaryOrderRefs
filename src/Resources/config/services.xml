<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Actualize\ActPrimaryOrderRefs\Service\PrimaryOrderRefsFiller">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Actualize\ActPrimaryOrderRefs\Subscriber\OrderRefsSubscriber">
            <argument type="service" id="Actualize\ActPrimaryOrderRefs\Service\PrimaryOrderRefsFiller"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Actualize\ActPrimaryOrderRefs\Command\FillPrimaryOrderRefsCommand">
            <argument type="service" id="Actualize\ActPrimaryOrderRefs\Service\PrimaryOrderRefsFiller"/>
            <tag name="console.command"/>
        </service>
    </services>
</container>
